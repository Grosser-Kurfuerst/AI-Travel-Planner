# Supabase 配置
# 从 Supabase 控制台获取: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 高德地图 JS API Key（用于前端地图显示）
# 从高德开放平台获取: https://console.amap.com/
NEXT_PUBLIC_AMAP_KEY=your_amap_js_api_key_here

# 科大讯飞语音识别配置（用于语音输入功能）
# 从科大讯飞控制台获取: https://console.xfyun.cn/services/iat
NEXT_PUBLIC_XFYUN_APP_ID=your_xfyun_app_id
NEXT_PUBLIC_XFYUN_API_KEY=your_xfyun_api_key
NEXT_PUBLIC_XFYUN_API_SECRET=your_xfyun_api_secret

